# ==============================================================================
# MILJÖVARIABLER FÖR BACKEND (Exempelfil)
# Kopiera detta innehåll till en ny fil döpt till enbart ".env" i backend-mappen.
# ==============================================================================

# Porten som backend-servern ska snurra på lokalt
PORT=3000

# ------------------------------------------------------------------------------
# DATABAS-ANSLUTNING (Railway)
# ------------------------------------------------------------------------------
# Skapa en MySQL-databas på Railway och hämta anslutningssträngen (Connection String).
# Beroende på var din backend körs väljer du en av följande URL-strukturer:

# ALTERNATIV A: För lokal utveckling (Detta ska vi använda just nu)
# Använd den "Externa URL:en" från Railway så att din lokala maskin kan nå databasen.
DATABASE_URL="mysql://root:LÖSENORD@DITT_PROXY_ID.proxy.rlwy.net:PORT/railway"

# ALTERNATIV B: För produktion / Driftsättning
# Används ENDAST om även backend är uppsatt och körs live på Railway.
# DATABASE_URL="mysql://root:LÖSENORD@mysql.railway.internal:3306/railway"